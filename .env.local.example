# Supabase — create a project at https://supabase.com then:
# 1. Run SQL in supabase/migrations/001_dashboard.sql (Supabase SQL Editor)
# 2. Optionally run supabase/seed.sql for demo data
# 3. Paste URL + anon key below, save, then RESTART `npm run dev` (required).

NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Alternatives (same values; resolved in app/page.tsx — never use the service_role key here):
# SUPABASE_URL=https://your-project.supabase.co
# SUPABASE_ANON_KEY=your-anon-key
